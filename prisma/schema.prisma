
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id        String   @id @default(cuid()) 
  name      String
  email     String   @unique 
  password          String 
  role              Role     @default(USER) 
  resetToken        String? 
  resetTokenExpiry  DateTime? 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  cards           Card[] 
  profile         Profile? 
  businessProfile BusinessProfile?
  staffMemberships BusinessStaff[]
  payments        Payment[] 
  subscriptions   Subscription[]

  @@map("users")
}

model Card {
  id String @id @default(cuid())

  cardId            String     @unique
  status            CardStatus @default(UNASSIGNED) 
  userId            String? 
  businessProfileId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  scans           Scan[] 

  @@index([cardId])
  @@index([userId]) 
  @@index([businessProfileId]) 
  @@map("cards")
}
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique 
  fullName  String
  jobTitle  String?
  company   String?
  phone     String?
  email     String?
  website   String?
  bio       String?
  imageUrl  String? 
  coverImageUrl String? 
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[] 

  @@map("profiles")
}
model BusinessProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  name        String 
  businessType BusinessType @default(RESTAURANT)
  category    String 
  description String?
  location    String?
  phone       String?
  email       String?
  website     String?
  imageUrl    String?
  paymentCode String?  
  settings    Json?    
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  menus Menu[] 
  inventoryResources InventoryResource[]
  cards Card[] 
  orders Order[]
  staff BusinessStaff[]
  guestFavorites GuestFavorite[]

  @@map("business_profiles")
}

model InventoryResource {
  id               String                @id @default(cuid())
  businessId       String
  name             String
  sku              String?
  category         InventoryCategory     @default(INGREDIENT)
  unit             InventoryUnit         @default(UNIT)
  stockQuantity    Float                 @default(0)
  lowStockThreshold Float                @default(0)
  costPerUnit      Float?
  supplier         String?
  storageLocation  String?
  notes            String?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, category])
  @@map("inventory_resources")
}

/// Staff members who can access the live order portal for a business
model BusinessStaff {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  staffRole  StaffRole @default(ORDERS)
  /// Which station this staff watches: KITCHEN | BAR | FLOOR | ALL
  station    PrepStation @default(ALL)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_staff")
}

model Menu {
  id         String   @id @default(cuid())
  businessId String
  title      String
  createdAt  DateTime @default(now())

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([businessId])
  @@map("menus")
}
model MenuItem {
  id          String   @id @default(cuid())
  menuId      String
  name        String
  sku         String?
  price       Float
  imageUrl    String?
  description String?
  /// Placeholder shown when guests customize this item (e.g. "less cheese, no onions…")
  customizationHint String?
  /// When true, guests can type free-text special instructions
  allowsSpecialInstructions Boolean @default(true)
  /// Structured options: { groups: [{ id, name, required, maxSelect, options: [{ id, name, priceDelta }] }] }
  customizationOptions Json?
  trackInventory Boolean @default(false)
  stockQuantity  Int?
  lowStockThreshold Int  @default(5)
  isSoldOut       Boolean          @default(false)
  /// ALL | HAPPY_HOUR | ROOM_SERVICE | DINE_IN
  availability    ItemAvailability @default(ALL)
  /// Kitchen / bar / floor routing for KDS
  station         PrepStation      @default(KITCHEN)
  createdAt   DateTime @default(now())


  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_items")
}
model Link {
  id        String @id @default(cuid())
  profileId String
  type      String 
  label     String 
  url       String 
  order     Int    @default(0) 


  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("links")
}
model Scan {
  id        String   @id @default(cuid())
  cardId    String 
  timestamp DateTime @default(now())
  device    String? 
  ip        String? 
  userAgent String? 

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, timestamp])
  @@map("scans")
}
model Payment {
  id     String @id @default(cuid())
  userId String


  plan         PlanType
  billingCycle BillingCycle

  amount   Float
  currency String @default("RWF")

  status PaymentStatus @default(PENDING)

  provider String
  method   PaymentMethod
  operator MobileOperator?

  reference String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

//Subscription model

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  plan          PlanType         
  billingCycle  BillingCycle       
  status        SubscriptionStatus  
  startDate     DateTime
  endDate       DateTime

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model Order {
  id            String       @id @default(cuid())
  businessId    String
  customerName  String
  phone         String
  orderContext  OrderContext @default(TABLE)
  tableNumber   String?
  roomNumber    String?
  /// Order-level special requests visible to kitchen/bar/staff
  notes         String?
  total         Float
  status        OrderStatus  @default(PENDING)
  prepStatus    PrepStatus   @default(NONE)
  txId          String?
  /// Snapshot lines with lineId, station, linePrepStatus, mods, notes
  items         Json
  /// Hash of phone+items for duplicate-order guard
  cartHash      String?
  /// Wait estimate (minutes) snapped at place-time from business settings
  estimatedWaitMinutes Int?
  rejectReasonCode String?
  rejectReason     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   OrderEvent[]

  @@index([businessId])
  @@index([status])
  @@index([prepStatus])
  @@index([businessId, phone, cartHash])
  @@map("orders")
}

/// Who confirmed / rejected / bumped prep — audit for MoMo disputes
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  actorUserId String?
  actorName   String?
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Last order cart for "Same as last time" by phone + business
model GuestFavorite {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  customerName String?
  items      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([businessId, phone])
  @@map("guest_favorites")
}

enum OrderContext {
  TABLE
  ROOM
  BAR_SEAT
}

enum BusinessType {
  RESTAURANT
  BAR
  HOTEL
  MOTEL
  CAFE
  OTHER
}

enum OrderStatus {
  PENDING              // Order placed, waiting for customer to pay
  WAITING_VERIFICATION // Customer submitted TxId, waiting for business to verify
  PAID                 // Business confirmed payment
  REJECTED             // Business rejected (wrong TxId or amount)
}

/// Kitchen / bar / room-service fulfilment tracking
enum PrepStatus {
  NONE
  RECEIVED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum StaffRole {
  ORDERS
  MANAGER
}

enum PrepStation {
  KITCHEN
  BAR
  FLOOR
  ALL
}

enum ItemAvailability {
  ALL
  HAPPY_HOUR
  ROOM_SERVICE
  DINE_IN
}

enum InventoryCategory {
  INGREDIENT
  PACKAGING
  SUPPLY
  PRODUCT
  OTHER
}

enum InventoryUnit {
  UNIT
  KG
  G
  LITER
  ML
  BOX
  PACK
  BOTTLE
  BAG
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlanType {
  FREE
  PLUS
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentMethod {
  MTN
  AIRTEL
}

enum MobileOperator {
  MTN
  AIRTEL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  BUSINESS
  STAFF
}

enum CardStatus {
  UNASSIGNED // Card exists in system but not linked to any user
  ACTIVE // Card is linked to a user and has an active profile
}
