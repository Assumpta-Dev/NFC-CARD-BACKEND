

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id        String   @id @default(cuid()) 
  name      String
  email     String   @unique 
  password          String 
  role              Role     @default(USER) 
  resetToken        String? 
  resetTokenExpiry  DateTime? 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  cards           Card[] 
  profile         Profile? 
  businessProfile BusinessProfile?
  payments        Payment[] 
  subscriptions   Subscription[]

  @@map("users")
}

model Card {
  id String @id @default(cuid())

  cardId            String     @unique
  status            CardStatus @default(UNASSIGNED) 
  userId            String? 
  businessProfileId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  scans           Scan[] 

  @@index([cardId])
  @@index([userId]) 
  @@index([businessProfileId]) 
  @@map("cards")
}
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique 
  fullName  String
  jobTitle  String?
  company   String?
  phone     String?
  email     String?
  website   String?
  bio       String?
  imageUrl  String? 
  coverImageUrl String? 
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[] 

  @@map("profiles")
}
model BusinessProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  name        String 
  businessType BusinessType @default(RESTAURANT)
  category    String 
  description String?
  location    String?
  phone       String?
  email       String?
  website     String?
  imageUrl    String?
  paymentCode String?  
  settings    Json?    
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  menus Menu[] 
  cards Card[] 
  orders Order[]

  @@map("business_profiles")
}

model Menu {
  id         String   @id @default(cuid())
  businessId String
  title      String
  createdAt  DateTime @default(now())

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([businessId])
  @@map("menus")
}
model MenuItem {
  id          String   @id @default(cuid())
  menuId      String
  name        String
  price       Float
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())


  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_items")
}
model Link {
  id        String @id @default(cuid())
  profileId String
  type      String 
  label     String 
  url       String 
  order     Int    @default(0) 


  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("links")
}
model Scan {
  id        String   @id @default(cuid())
  cardId    String 
  timestamp DateTime @default(now())
  device    String? 
  ip        String? 
  userAgent String? 

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, timestamp])
  @@map("scans")
}
model Payment {
  id     String @id @default(cuid())
  userId String


  plan         PlanType
  billingCycle BillingCycle

  amount   Float
  currency String @default("RWF")

  status PaymentStatus @default(PENDING)

  provider String
  method   PaymentMethod
  operator MobileOperator?

  reference String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

//Subscription model

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  plan          PlanType         
  billingCycle  BillingCycle       
  status        SubscriptionStatus  
  startDate     DateTime
  endDate       DateTime

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model Order {
  id            String       @id @default(cuid())
  businessId    String
  customerName  String
  phone         String
  orderContext  OrderContext @default(TABLE)
  tableNumber   String?
  roomNumber    String?
  total         Float
  status        OrderStatus  @default(PENDING)
  txId          String?
  items         Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@map("orders")
}

enum OrderContext {
  TABLE
  ROOM
}

enum BusinessType {
  RESTAURANT
  HOTEL
  MOTEL
  CAFE
  OTHER
}

enum OrderStatus {
  PENDING              // Order placed, waiting for customer to pay
  WAITING_VERIFICATION // Customer submitted TxId, waiting for business to verify
  PAID                 // Business confirmed payment
  REJECTED             // Business rejected (wrong TxId or amount)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlanType {
  FREE
  PLUS
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentMethod {
  MTN
  AIRTEL
}

enum MobileOperator {
  MTN
  AIRTEL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  BUSINESS // NEW
}

enum CardStatus {
  UNASSIGNED // Card exists in system but not linked to any user
  ACTIVE // Card is linked to a user and has an active profile
}
